# Copy this file to .env and fill in the values from your Apps Script Web App
# deployment (see apps-script/Code.gs for setup steps). docker-compose reads
# .env automatically.

# The Web App /exec URL from Deploy > New deployment.
SHEETS_WEBAPP_URL=

# The same secret you stored in the Apps Script project's Script Properties
# as API_TOKEN.
SHEETS_API_TOKEN=

# Free-tier key from https://aistudio.google.com/app/apikey, used by the
# /chat (AI conversation practice) endpoint.
GEMINI_API_KEY=

# Optional — defaults to gemini-2.0-flash if left blank.
GEMINI_MODEL=
